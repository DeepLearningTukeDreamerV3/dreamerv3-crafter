# Copy to .env and adjust. Docker Compose reads .env automatically.

# Image tag for dreamerv3:<TAG>.
TAG=latest

# Host directory for checkpoints, metrics, and videos (mounted at /logdir).
LOGDIR=./logdir

# Config blocks from dreamerv3/configs.yaml, applied in order.
# GPU service. On a 4 GB GPU, try "crafter size12m".
CONFIGS=crafter
# CPU service. Keep "debug" for small networks.
CONFIGS_CPU=crafter debug

# Replayed steps trained per environment step.
TRAIN_RATIO=32

# Fraction of GPU memory JAX preallocates.
XLA_MEM_FRACTION=0.8

# Host port for the scope viewer.
VIEWER_PORT=8000
